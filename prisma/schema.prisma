generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  username      String?        @unique
  email         String?        @unique
  phone         String?
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole       @default(STAFF)
  isActive      Boolean        @default(true)
  lakeId        String?
  appUsageTime  Int?           @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  accounts      Account[]
  activityLogs  ActivityLog[]
  attendances   Attendance[]
  managedLake   FishingLake[]  @relation("LakeManager")
  lake          FishingLake?   @relation("LakeUsers", fields: [lakeId], references: [id])
  notifications Notification[]
  sessions      Session[]
  shiftSessions ShiftSession[]
  shiftCloses   ShiftClose[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id          String    @id @default(cuid())
  fullName    String
  phone       String    @unique
  address     String?
  debtBalance Decimal   @default(0) @db.Decimal(12, 2)
  totalSpent  Decimal   @default(0) @db.Decimal(12, 2)
  visitCount  Int       @default(0)
  isVip       Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  lakeId      String?

  // Loyalty program
  loyaltyPoints Int    @default(0)
  totalPoints   Int    @default(0)
  loyaltyTier   String @default("BRONZE")

  lake         FishingLake?     @relation(fields: [lakeId], references: [id])
  sessions     FishingSession[]
  invoices     Invoice[]
  pointHistory PointHistory[]
}

model FishingLake {
  id          String    @id @default(cuid())
  name        String
  description String?
  address     String?
  phone       String?
  managerId   String?
  totalSpots  Int       @default(10)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // SaaS Subscription fields
  subscriptionPlan      String             @default("BASIC") // BASIC, PREMIUM
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  subscriptionExpiresAt DateTime?

  // Bank / VietQR settings
  bankName    String?
  bankAccount String?
  bankHolder  String?
  bankBin     String?

  // Loyalty config
  loyaltyPointRate Int @default(10000)

  customers          Customer[]
  areas              FishingArea[]
  manager            User?               @relation("LakeManager", fields: [managerId], references: [id])
  users              User[]              @relation("LakeUsers")
  sessions           FishingSession[]
  products           Product[]
  invoices           Invoice[]
  expenses           Expense[]
  transactions       Transaction[]
  activityLogs       ActivityLog[]
  fishStocks         FishStock[]
  shiftSessions      ShiftSession[]
  shiftCloses        ShiftClose[]
  subscriptionOrders SubscriptionOrder[]
}

model FishingArea {
  id          String           @id @default(cuid())
  lakeId      String
  name        String
  capacity    Int              @default(1)
  hourlyRate  Decimal          @db.Decimal(12, 2)
  minDuration Int              @default(1)
  status      AreaStatus       @default(AVAILABLE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  lake        FishingLake      @relation(fields: [lakeId], references: [id], onDelete: Cascade)
  sessions    FishingSession[]
}

model FishingSession {
  id             String          @id @default(cuid())
  lakeId         String
  areaId         String
  customerId     String?
  startTime      DateTime        @default(now())
  endTime        DateTime?
  status         SessionStatus   @default(ACTIVE)
  hourlyRate     Decimal         @db.Decimal(12, 2)
  totalHours     Float?
  sessionAmount  Decimal         @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  packageId      String?
  prepaidAmount  Decimal         @default(0) @db.Decimal(12, 2)
  fishCatches    FishCatch[]
  area           FishingArea     @relation(fields: [areaId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  lake           FishingLake     @relation(fields: [lakeId], references: [id])
  FishingPackage FishingPackage? @relation(fields: [packageId], references: [id])
  invoices       Invoice[]
}

model FishType {
  id           String      @id @default(cuid())
  name         String      @unique
  buybackPrice Decimal     @db.Decimal(12, 2)
  image        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  catches      FishCatch[]
  fishStocks   FishStock[]
}

model FishCatch {
  id           String         @id @default(cuid())
  sessionId    String
  fishTypeId   String
  weight       Decimal        @db.Decimal(10, 2)
  buybackPrice Decimal        @db.Decimal(12, 2)
  totalAmount  Decimal        @db.Decimal(12, 2)
  isSoldBack   Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  fishType     FishType       @relation(fields: [fishTypeId], references: [id])
  session      FishingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model FishStock {
  id              String      @id @default(cuid())
  lakeId          String
  fishTypeId      String
  initialWeight   Decimal     @db.Decimal(10, 2)
  initialQuantity Int
  currentWeight   Decimal     @db.Decimal(10, 2)
  currentQuantity Int
  deadCount       Int         @default(0)
  addedCount      Int         @default(0)
  addedWeight     Decimal     @default(0) @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  lake            FishingLake @relation(fields: [lakeId], references: [id])
  fishType        FishType    @relation(fields: [fishTypeId], references: [id])

  @@unique([lakeId, fishTypeId])
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  products  Product[]
}

model Product {
  id           String                 @id @default(cuid())
  categoryId   String
  name         String
  sku          String?                @unique
  barcode      String?                @unique
  description  String?
  price        Decimal                @db.Decimal(12, 2)
  costPrice    Decimal?               @db.Decimal(12, 2)
  stock        Int                    @default(0)
  minStock     Int                    @default(5)
  unit         String                 @default("Cái")
  image        String?
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deletedAt    DateTime?
  lakeId       String?
  transactions InventoryTransaction[]
  invoiceItems InvoiceItem[]
  category     ProductCategory        @relation(fields: [categoryId], references: [id])
  lake         FishingLake?           @relation(fields: [lakeId], references: [id])
}

model InventoryTransaction {
  id          String    @id @default(cuid())
  productId   String
  type        StockType
  quantity    Int
  note        String?
  performedBy String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  product     Product   @relation(fields: [productId], references: [id])
}

model Invoice {
  id            String          @id @default(cuid())
  invoiceNumber String          @unique
  customerId    String?
  sessionId     String?
  subtotal      Decimal         @db.Decimal(12, 2)
  discount      Decimal         @default(0) @db.Decimal(12, 2)
  tax           Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal         @db.Decimal(12, 2)
  status        InvoiceStatus   @default(UNPAID)
  lakeId        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  lake          FishingLake?    @relation(fields: [lakeId], references: [id])
  customer      Customer?       @relation(fields: [customerId], references: [id])
  session       FishingSession? @relation(fields: [sessionId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  totalPrice  Decimal   @db.Decimal(12, 2)
  deletedAt   DateTime?
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  transactionId String?
  note          String?
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
}

model Expense {
  id          String       @id @default(cuid())
  category    String
  description String
  amount      Decimal      @db.Decimal(12, 2)
  date        DateTime     @default(now())
  lakeId      String?
  performedBy String?
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
  lake        FishingLake? @relation(fields: [lakeId], references: [id])
}

model Attendance {
  id        String    @id @default(cuid())
  userId    String
  date      DateTime  @default(now())
  checkIn   DateTime
  checkOut  DateTime?
  status    String    @default("PRESENT")
  note      String?
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
}

model Shift {
  id        String    @id @default(cuid())
  name      String
  startTime String
  endTime   String
  notes     String?
  deletedAt DateTime?
}

model ShiftSession {
  id             String      @id @default(cuid())
  lakeId         String
  userId         String
  startTime      DateTime    @default(now())
  endTime        DateTime?
  status         String      @default("RUNNING")
  ticketRevenue  Decimal     @default(0) @db.Decimal(12, 2)
  productRevenue Decimal     @default(0) @db.Decimal(12, 2)
  totalRevenue   Decimal     @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  user           User        @relation(fields: [userId], references: [id])
  lake           FishingLake @relation(fields: [lakeId], references: [id])
}

model ShiftClose {
  id             String      @id @default(cuid())
  lakeId         String
  userId         String
  shiftDate      DateTime    @default(now())
  ticketRevenue  Decimal     @default(0) @db.Decimal(12, 2)
  productRevenue Decimal     @default(0) @db.Decimal(12, 2)
  totalCash      Decimal     @default(0) @db.Decimal(12, 2)
  totalTransfer  Decimal     @default(0) @db.Decimal(12, 2)
  expectedCash   Decimal     @default(0) @db.Decimal(12, 2)
  actualCash     Decimal     @default(0) @db.Decimal(12, 2)
  discrepancy    Decimal     @default(0) @db.Decimal(12, 2)
  status         String      @default("CLOSED")
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  user           User        @relation(fields: [userId], references: [id])
  lake           FishingLake @relation(fields: [lakeId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean   @default(false)
  type      String    @default("INFO")
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id         String       @id @default(cuid())
  userId     String
  lakeId     String?
  entityType String?
  entityId   String?
  action     String
  details    Json?
  createdAt  DateTime     @default(now())
  deletedAt  DateTime?
  user       User         @relation(fields: [userId], references: [id])
  lake       FishingLake? @relation(fields: [lakeId], references: [id])
}

model Settings {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model FishingPackage {
  id             String           @id
  name           String
  durationHours  Float
  price          Decimal          @db.Decimal(12, 2)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  FishingSession FishingSession[]
}

model Transaction {
  id            String      @id @default(cuid())
  lakeId        String
  type          String
  amount        Decimal     @db.Decimal(12, 2)
  description   String?
  category      String?
  referenceId   String?
  paymentMethod String?
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?
  lake          FishingLake @relation(fields: [lakeId], references: [id])
}

model SubscriptionOrder {
  id             String      @id @default(cuid())
  lakeId         String
  plan           String
  durationMonths Int
  amount         Decimal     @db.Decimal(12, 2)
  status         String      @default("PENDING")
  paymentMethod  String      @default("TRANSFER")
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  lake           FishingLake @relation(fields: [lakeId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
  CASHIER
}

enum AreaStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLOSED
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  OVERDUE
}

enum StockType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
  REFUNDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  DEBT
}

model PointHistory {
  id          String    @id @default(cuid())
  customerId  String
  points      Int
  type        String
  description String
  referenceId String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model OtpVerification {
  id        String    @id @default(cuid())
  phone     String
  otp       String
  expiresAt DateTime
  verified  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([phone])
}
